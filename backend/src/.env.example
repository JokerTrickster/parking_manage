# Server Configuration
HOST=0.0.0.0
PORT=5000
ENV=production
DEBUG=true
IS_LOCAL=false

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=parking_dev
DB_USER=root
DB_PASSWORD=your-password

# JWT Configuration
JWT_SECRET=your-secret-key
JWT_EXPIRE_HOURS=24

# File Upload Configuration
UPLOAD_PATH=../../shared
MAX_FILE_SIZE=10485760

# CORS Configuration
# 로컬 개발: http://172.16.32.108:5050
# 배포 서버: http://192.168.0.102:5050
ALLOWED_ORIGINS=http://localhost:5050

# Logging Configuration
LOG_LEVEL=debug
LOG_FILE=logs/app.log
